{
  "manifest_version": 1,
  "type": "device",
  "name": "Huawei Solar",
  "description": {
    "en": "Huawei SUN2000 inverters, LUNA2000 batteries and power meters, local or cloud.",
    "fr": "Onduleurs Huawei SUN2000, batteries LUNA2000 et compteurs, en local ou cloud.",
    "de": "Huawei SUN2000 Wechselrichter, LUNA2000 Akkus und Zähler, lokal oder Cloud.",
    "es": "Inversores Huawei SUN2000, baterías LUNA2000 y medidores, local o nube."
  },
  "version": "1.1.0",
  "docker_image": "ghcr.io/gboulvin/gladys-huawei-solar:1.1.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/gboulvin/Gladys-Huawei-Solar/main/cover.png",
  "categories": ["energy"],
  "keywords": [
    "Huawei",
    "SUN2000",
    "LUNA2000",
    "FusionSolar",
    "SDongle",
    "EMMA",
    "inverter",
    "onduleur",
    "Modbus",
    "solar"
  ],
  "transports": ["local", "cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Connect your Huawei installation locally (Modbus TCP through the SDongle, EMMA or the inverter WLAN) and/or through the FusionSolar cloud (Northbound API account). With both, the toggle below picks the preferred one and the other is used as a fallback. Commands (battery, export limit) need the local connection.",
        "fr": "Connectez votre installation Huawei en local (Modbus TCP via le SDongle, l'EMMA ou le Wi-Fi de l'onduleur) et/ou via le cloud FusionSolar (compte API Northbound). Avec les deux, l'interrupteur ci-dessous choisit la connexion préférée, l'autre sert de secours. Les commandes (batterie, limite d'injection) nécessitent la connexion locale.",
        "de": "Verbinden Sie Ihre Huawei-Anlage lokal (Modbus TCP über SDongle, EMMA oder das WLAN des Wechselrichters) und/oder über die FusionSolar-Cloud (Northbound-API-Konto). Mit beiden wählt der Schalter unten die bevorzugte Verbindung, die andere dient als Ersatz. Befehle (Akku, Einspeisebegrenzung) erfordern die lokale Verbindung.",
        "es": "Conecte su instalación Huawei en local (Modbus TCP mediante el SDongle, el EMMA o el WLAN del inversor) y/o mediante la nube FusionSolar (cuenta API Northbound). Con ambas, el interruptor de abajo elige la preferida y la otra sirve de respaldo. Las órdenes (batería, límite de inyección) requieren la conexión local."
      },
      "links": [
        {
          "url": "https://github.com/gboulvin/Gladys-Huawei-Solar#readme",
          "label": {
            "en": "Integration guide",
            "fr": "Guide de l'intégration",
            "de": "Anleitung zur Integration",
            "es": "Guía de la integración"
          }
        }
      ]
    },
    {
      "key": "local_section",
      "type": "section",
      "label": {
        "en": "Local connection (Modbus TCP)",
        "fr": "Connexion locale (Modbus TCP)",
        "de": "Lokale Verbindung (Modbus TCP)",
        "es": "Conexión local (Modbus TCP)"
      },
      "description": {
        "en": "Enable Modbus TCP on the SDongle in the FusionSolar app (Device commissioning > Settings > Communication configuration > Dongle parameter settings > Modbus TCP: Enable (unrestricted)). Port 502 through the SDongle; port 6607 and unit id 0 through the inverter WLAN.",
        "fr": "Activez Modbus TCP sur le SDongle dans l'application FusionSolar (Mise en service > Paramètres > Configuration de la communication > Paramètres du Dongle > Modbus TCP : Activer (sans restriction)). Port 502 via le SDongle ; port 6607 et unit id 0 via le Wi-Fi de l'onduleur.",
        "de": "Aktivieren Sie Modbus TCP am SDongle in der FusionSolar-App (Inbetriebnahme > Einstellungen > Kommunikationskonfiguration > Dongle-Parameter > Modbus TCP: Aktivieren (uneingeschränkt)). Port 502 über den SDongle; Port 6607 und Unit-ID 0 über das WLAN des Wechselrichters.",
        "es": "Active Modbus TCP en el SDongle desde la app FusionSolar (Puesta en servicio > Ajustes > Configuración de comunicación > Parámetros del Dongle > Modbus TCP: Activar (sin restricción)). Puerto 502 mediante el SDongle; puerto 6607 y unit id 0 mediante el WLAN del inversor."
      }
    },
    {
      "key": "modbus_host",
      "type": "string",
      "label": {
        "en": "Inverter / SDongle address",
        "fr": "Adresse de l’onduleur / SDongle",
        "de": "Adresse Wechselrichter / SDongle",
        "es": "Dirección del inversor / SDongle"
      },
      "description": {
        "en": "IP address or host name on your local network. Leave empty to use the cloud only.",
        "fr": "Adresse IP ou nom d’hôte sur votre réseau local. Laissez vide pour utiliser uniquement le cloud.",
        "de": "IP-Adresse oder Hostname im lokalen Netzwerk. Leer lassen, um nur die Cloud zu nutzen.",
        "es": "Dirección IP o nombre de host en su red local. Déjelo vacío para usar solo la nube."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.50",
        "fr": "ex. 192.168.1.50",
        "de": "z. B. 192.168.1.50",
        "es": "p. ej. 192.168.1.50"
      },
      "required": false
    },
    {
      "key": "modbus_port",
      "type": "number",
      "label": {
        "en": "Modbus port",
        "fr": "Port Modbus",
        "de": "Modbus-Port",
        "es": "Puerto Modbus"
      },
      "required": false,
      "default": 502,
      "min": 1,
      "max": 65535
    },
    {
      "key": "modbus_unit_id",
      "type": "number",
      "label": {
        "en": "Modbus unit id",
        "fr": "Unit id Modbus",
        "de": "Modbus-Unit-ID",
        "es": "Unit id Modbus"
      },
      "description": {
        "en": "Usually 1 through the SDongle, 0 through the inverter WLAN.",
        "fr": "Généralement 1 via le SDongle, 0 via le Wi-Fi de l’onduleur.",
        "de": "Meist 1 über den SDongle, 0 über das WLAN des Wechselrichters.",
        "es": "Normalmente 1 mediante el SDongle, 0 mediante el WLAN del inversor."
      },
      "required": false,
      "default": 1,
      "min": 0,
      "max": 247
    },
    {
      "key": "cloud_section",
      "type": "section",
      "label": {
        "en": "Cloud connection (FusionSolar)",
        "fr": "Connexion cloud (FusionSolar)",
        "de": "Cloud-Verbindung (FusionSolar)",
        "es": "Conexión en la nube (FusionSolar)"
      },
      "description": {
        "en": "Uses the FusionSolar Northbound API: ask your installer for an API account (System > Company Management > Northbound Management). Your usual app login does not work here. Data is refreshed every 5 minutes at most.",
        "fr": "Utilise l'API Northbound de FusionSolar : demandez un compte API à votre installateur (Système > Gestion de l'entreprise > Gestion Northbound). Vos identifiants habituels de l'application ne fonctionnent pas ici. Les données sont rafraîchies toutes les 5 minutes au mieux.",
        "de": "Nutzt die FusionSolar-Northbound-API: Bitten Sie Ihren Installateur um ein API-Konto (System > Unternehmensverwaltung > Northbound-Verwaltung). Ihr normales App-Login funktioniert hier nicht. Die Daten werden höchstens alle 5 Minuten aktualisiert.",
        "es": "Usa la API Northbound de FusionSolar: pida a su instalador una cuenta API (Sistema > Gestión de empresa > Gestión Northbound). Su usuario habitual de la app no sirve aquí. Los datos se actualizan cada 5 minutos como máximo."
      },
      "links": [
        {
          "url": "https://eu5.fusionsolar.huawei.com",
          "label": {
            "en": "FusionSolar",
            "fr": "FusionSolar",
            "de": "FusionSolar",
            "es": "FusionSolar"
          }
        }
      ]
    },
    {
      "key": "fusionsolar_url",
      "type": "string",
      "label": {
        "en": "FusionSolar server",
        "fr": "Serveur FusionSolar",
        "de": "FusionSolar-Server",
        "es": "Servidor FusionSolar"
      },
      "description": {
        "en": "The address you use to log in to FusionSolar in a browser, e.g. https://eu5.fusionsolar.huawei.com or https://intl.fusionsolar.huawei.com.",
        "fr": "L'adresse que vous utilisez pour vous connecter à FusionSolar dans un navigateur, ex. https://eu5.fusionsolar.huawei.com ou https://intl.fusionsolar.huawei.com.",
        "de": "Die Adresse, mit der Sie sich im Browser bei FusionSolar anmelden, z. B. https://eu5.fusionsolar.huawei.com oder https://intl.fusionsolar.huawei.com.",
        "es": "La dirección que usa para entrar en FusionSolar desde un navegador, p. ej. https://eu5.fusionsolar.huawei.com o https://intl.fusionsolar.huawei.com."
      },
      "placeholder": {
        "en": "https://eu5.fusionsolar.huawei.com",
        "fr": "https://eu5.fusionsolar.huawei.com",
        "de": "https://eu5.fusionsolar.huawei.com",
        "es": "https://eu5.fusionsolar.huawei.com"
      },
      "required": false,
      "default": "https://eu5.fusionsolar.huawei.com"
    },
    {
      "key": "fusionsolar_username",
      "type": "string",
      "label": {
        "en": "API user name",
        "fr": "Nom d’utilisateur API",
        "de": "API-Benutzername",
        "es": "Usuario de la API"
      },
      "placeholder": {
        "en": "Northbound API account",
        "fr": "Compte API Northbound",
        "de": "Northbound-API-Konto",
        "es": "Cuenta API Northbound"
      },
      "required": false
    },
    {
      "key": "fusionsolar_password",
      "type": "secret",
      "label": {
        "en": "API password (system code)",
        "fr": "Mot de passe API (system code)",
        "de": "API-Passwort (System-Code)",
        "es": "Contraseña API (system code)"
      },
      "required": false
    },
    {
      "key": "advanced_section",
      "type": "section",
      "label": {
        "en": "Advanced settings",
        "fr": "Réglages avancés",
        "de": "Erweiterte Einstellungen",
        "es": "Ajustes avanzados"
      },
      "description": {
        "en": "Refresh interval of the readings and dead band of the \"grid exchange changed\" scene trigger.",
        "fr": "Fréquence de lecture des mesures et zone morte du déclencheur de scène « l’échange réseau change ».",
        "de": "Ausleseintervall der Messwerte und Totband des Szenen-Auslösers „Netzaustausch geändert“.",
        "es": "Intervalo de lectura de las medidas y banda muerta del disparador de escena «cambio en el intercambio con la red»."
      }
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)",
        "de": "Aktualisierungsintervall (s)",
        "es": "Intervalo de actualización (s)"
      },
      "description": {
        "en": "How often the installation is read, in seconds (30 s minimum locally, 300 s minimum through the cloud).",
        "fr": "Fréquence de lecture de l'installation, en secondes (30 s minimum en local, 300 s minimum via le cloud).",
        "de": "Wie oft die Anlage ausgelesen wird, in Sekunden (lokal mindestens 30 s, über die Cloud mindestens 300 s).",
        "es": "Cada cuánto se lee la instalación, en segundos (mínimo 30 s en local, 300 s mediante la nube)."
      },
      "required": false,
      "default": 60,
      "min": 30,
      "max": 3600
    },
    {
      "key": "grid_threshold",
      "type": "number",
      "label": {
        "en": "Grid dead band (W)",
        "fr": "Zone morte réseau (W)",
        "de": "Netz-Totband (W)",
        "es": "Banda muerta de red (W)"
      },
      "description": {
        "en": "Below this power, the grid exchange counts as balanced: avoids flapping triggers around zero.",
        "fr": "Sous cette puissance, l’échange avec le réseau est considéré équilibré : évite les déclenchements répétés autour de zéro.",
        "de": "Unterhalb dieser Leistung gilt der Netzaustausch als ausgeglichen: vermeidet ständiges Auslösen um null.",
        "es": "Por debajo de esta potencia, el intercambio con la red se considera equilibrado: evita disparos repetidos en torno a cero."
      },
      "required": false,
      "default": 100,
      "min": 0,
      "max": 5000
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Reads the installation through every configured channel.",
        "fr": "Lit l'installation par chaque connexion configurée.",
        "de": "Liest die Anlage über jede konfigurierte Verbindung aus.",
        "es": "Lee la instalación por cada conexión configurada."
      },
      "timeout_seconds": 60
    }
  ],
